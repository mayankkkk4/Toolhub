# Nginx Production Configuration Template for ToolHub Subdomain
# Replace 'toolhub.MYDOMAIN.com' with your actual domain (e.g. toolhub.runs-at.dev)

# HTTP Server (Redirects all traffic to HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name toolhub.MYDOMAIN.com;

    # Certbot challenge path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name toolhub.MYDOMAIN.com;

    # SSL Certificates (Managed by Certbot / Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/toolhub.MYDOMAIN.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toolhub.MYDOMAIN.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Maximum file upload size (matches Flask config)
    client_max_body_size 16M;

    # Reverse Proxy to Gunicorn WSGI Server
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    # Static Assets Caching
    location /static/ {
        alias /var/www/toolhub/static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
